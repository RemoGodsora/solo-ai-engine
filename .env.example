# Groq Inference Engine
GROQ_API_KEY=gsk_your_groq_api_key_here

# Studio Master Key (Administrative tenant provisioning)
MASTER_ADMIN_KEY=dev_secret_key_123

# Database URL (SQLite Async Engine)
DATABASE_URL=sqlite+aiosqlite:///./studio.db

# Operational Webhook Alerting (Slack or Discord Incoming Webhook URL)
DISCORD_SLACK_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token